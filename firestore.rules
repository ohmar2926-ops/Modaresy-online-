
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || me().role == 'teacher');
      allow update: if signedIn() && request.auth.uid == uid;
    }

    match /classes/{classId} {
      allow read: if signedIn() &&
        (resource.data.teacherId == request.auth.uid ||
         request.auth.uid in resource.data.studentIds);
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.teacherId == request.auth.uid;
    }

    match /assignments/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.teacherId == request.auth.uid;
    }
  }
}
